{
  "name": "purpleair-api",
  "version": "2026.11.11-alpha.2",
  "description": "PurpleAir API Node.js bindings with C++ backend",
  "author": "carlkidcrypto",
  "license": "MIT",
  "homepage": "https://carlkidcrypto.github.io/purpleair_api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlkidcrypto/purpleair_api.git"
  },
  "bugs": {
    "url": "https://github.com/carlkidcrypto/purpleair_api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "build/Release/purpleairapi_base.node",
    "build/Release/.dylibs/**",
    "build/Release/libs/**",
    "build/Release/*.dll",
    "build/Release/*.so*"
  ],
  "scripts": {
    "swig": "swig -javascript -napi -c++ -I../swig/interface -I../swig/include -outdir . -o purpleairapi_base_wrap.cxx ../swig/interface/purpleairapi_base.i",
    "build-gyp": "node-gyp rebuild",
    "prebuild": "npm run swig",
    "build": "npm run build-gyp",
    "install": "node -e \"\"",
    "test": "jest",
    "clean": "rm -f purpleairapi_base_wrap.cxx && node-gyp clean"
  },
  "keywords": [
    "purpleair",
    "api",
    "air-quality",
    "sensor"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "node-gyp": "^11.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
